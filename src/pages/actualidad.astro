---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { news } from '../data/content';
const base = '/fe-y-costumbres/';
---
<SiteLayout title="Actualidad — Fe y Raíces" description="Noticias recientes sobre fe, comunidad y tradiciones, con enlaces a las fuentes originales.">
  <SiteHeader current="actualidad" />
  <main id="contenido" class="page-main">
    <div class="container">
      <div class="page-intro"><div class="eyebrow">Voces y acontecimientos</div><h1>Actualidad con mirada humana</h1><p>Una selección de noticias vinculadas a la fe, las comunidades y las tradiciones. Resumimos cada nota y enlazamos su publicación original para que puedas leer más.</p></div>
      <div class="page-grid">
        {news.map((item) => <article class="news-card">
          <div class="card-meta"><span>{item.date}</span><span class="category-pill">{item.tag}</span></div>
          <h3>{item.title}</h3><p>{item.summary}</p>
          <div class="card-bottom"><span class="source">Fuente: {item.source}</span><a class="read-arrow" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`Leer en ${item.source}`}>↗</a></div>
        </article>)}
      </div>
      <div class="feature-note"><b>Sobre esta sección:</b> las notas de esta primera selección están fechadas y no se actualizan automáticamente. Actualizaremos los enlaces al agregar nuevas noticias. Consulta siempre la fuente para confirmar información, horarios y cambios.</div>
      <div style="margin-top:25px"><a class="button" href={`${base}#consultas`}>Sugerir una noticia <span aria-hidden="true">↗</span></a></div>
    </div>
  </main>
  <SiteFooter />
</SiteLayout>
