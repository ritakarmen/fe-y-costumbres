---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InquiryForms from '../components/InquiryForms.astro';
import HomeIcon from '../components/HomeIcon.astro';
import CmsMaterials from '../components/CmsMaterials.astro';
import { news, traditions } from '../data/content';
import '../styles/home.css';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const topics = [
  { name: 'Espiritualidad', detail: 'Un momento para ti', icon: 'sun', id: 'espiritualidad' },
  { name: 'Fe y vida diaria', detail: 'Creer también es cuidar', icon: 'heart', id: 'fe-y-vida' },
  { name: 'Diálogo y respeto', detail: 'Escuchar nos acerca', icon: 'dialogue', id: 'dialogo' },
  { name: 'Familia y comunidad', detail: 'Lo que nos hace parte', icon: 'community', id: 'familia' },
] as const;
const featuredNews = news[0];
---
<SiteLayout
  title="Fe y Costumbres — Historias que nos unen"
  description="Descubre historias de fe, tradiciones del Perú y celebraciones que nos unen. Un espacio para inspirarnos, aprender y compartir en comunidad."
  bodyClass="home-page"
>
  <SiteHeader current="inicio" />
  <main id="contenido">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="container home-hero-grid">
        <div class="home-hero-copy">
          <span class="home-eyebrow"><span class="home-status-dot" aria-hidden="true"></span> Un espacio para encontrarnos</span>
          <h1 id="hero-title">La fe nos inspira.<br />Las raíces<br /><em>nos unen.</em></h1>
          <p>Hay historias que se heredan y tradiciones que se sienten. Descubre la fe, la cultura y los pequeños rituales que nos acercan.</p>
          <div class="home-actions">
            <a class="home-button" href="#actualidad">Explorar historias <HomeIcon name="arrow" /></a>
            <a class="home-button home-button-light" href={`${base}tradiciones/`}>Nuestras tradiciones</a>
          </div>
          <div class="home-origin"><span><HomeIcon name="globe" /></span><p><strong>De Perú al mundo</strong><br />Muchas formas de creer. Un lugar para compartir.</p></div>
        </div>
        <div class="home-hero-visual">
          <div class="home-image-frame">
            <img src={`${base}images/andes-chapel.svg`} width="720" height="800" fetchpriority="high" alt="Ilustración de una capilla entre montañas andinas, árboles y un camino que invita al encuentro." />
            <span class="home-image-tag"><HomeIcon name="spark" /> Tradiciones vivas</span>
            <span class="home-image-caption">MEMORIA, CULTURA Y PERTENENCIA</span>
          </div>
          <a class="home-floating-story" href={`${base}tradiciones/`}>
            <span class="home-story-icon"><HomeIcon name="heart" /></span>
            <span><small>LO QUE NOS CONECTA</small><strong>Lo nuestro merece<br />seguir contándose.</strong></span>
            <span class="home-story-arrow"><HomeIcon name="arrow" /></span>
          </a>
          <span class="home-orbit" aria-hidden="true">✳</span>
        </div>
      </div>
      <div class="container home-values" aria-label="Nuestros valores">
        <span><HomeIcon name="spark" /> Cultura que perdura</span>
        <span><HomeIcon name="heart" /> Fe que acompaña</span>
        <span><HomeIcon name="community" /> Historias que acercan</span>
        <a href="#temas">Encuentra tu inspiración <HomeIcon name="arrow" /></a>
      </div>
    </section>

    <section class="home-topics home-section" id="temas" aria-labelledby="topics-title">
      <div class="container">
        <div class="home-section-top home-section-top-compact">
          <div><span class="home-kicker">CADA CAMINO TIENE SU HISTORIA</span><h2 id="topics-title">¿Qué te inspira hoy?</h2></div>
          <a class="home-text-link" href={`${base}temas/`}>Explorar todos los temas <HomeIcon name="arrow" /></a>
        </div>
        <div class="home-topic-grid">
          {topics.map((topic) => (
            <a class="home-topic" href={`${base}temas/#${topic.id}`}>
              <span class={`home-topic-icon home-topic-icon-${topic.icon}`}><HomeIcon name={topic.icon} /></span>
              <div class="home-topic-copy"><h3>{topic.name}</h3><p>{topic.detail}</p></div>
              <span class="home-topic-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-journal home-section" id="actualidad" aria-labelledby="journal-title">
      <div class="container">
        <div class="home-section-top">
          <div><span class="home-kicker">UNA MIRADA A LO QUE NOS RODEA</span><h2 id="journal-title">Historias para <em>conectar.</em></h2><p>Fe, cultura y comunidad en las conversaciones de hoy.</p></div>
          <a class="home-text-link" href={`${base}actualidad/`}>Toda la actualidad <HomeIcon name="arrow" /></a>
        </div>
        <div class="home-journal-grid">
          <article class="home-featured-article">
            <div class="home-featured-top"><span class="home-tag">{featuredNews.tag}</span><span>{featuredNews.date}</span></div>
            <div class="home-featured-symbol" aria-hidden="true"><HomeIcon name="globe" /></div>
            <div class="home-featured-content">
              <span class="home-featured-label">EN PRIMER PLANO</span>
              <h3><a href={featuredNews.url} target="_blank" rel="noopener noreferrer">{featuredNews.title}</a></h3>
              <p>{featuredNews.summary}</p>
              <div class="home-article-bottom"><span>Fuente: {featuredNews.source}</span><a href={featuredNews.url} target="_blank" rel="noopener noreferrer" aria-label={`Leer ${featuredNews.title} en ${featuredNews.source} (nueva pestaña)`}><HomeIcon name="arrow" /></a></div>
            </div>
          </article>
          <div class="home-article-list">
            {news.slice(1, 3).map((item, index) => (
              <article class="home-article">
                <div class="home-article-meta"><span class="home-tag">{item.tag}</span><span>{item.date}</span><span class="home-article-number" aria-hidden="true">0{index + 2}</span></div>
                <h3><a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a></h3>
                <p>{item.summary}</p>
                <div class="home-article-bottom"><span>{item.source}</span><a class="home-text-link" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`Leer ${item.title} en ${item.source} (nueva pestaña)`}>Leer historia <HomeIcon name="arrow" /></a></div>
              </article>
            ))}
          </div>
        </div>
        <p class="home-editorial-note">Selección editorial · 12 de noviembre de 2026. Cada historia enlaza a su fuente original.</p>
      </div>
    </section>

    <section class="home-traditions home-section" id="tradiciones" aria-labelledby="traditions-title">
      <div class="container">
        <div class="home-section-top">
          <div><span class="home-kicker">NUESTRA CULTURA ESTÁ VIVA</span><h2 id="traditions-title">Raíces que <em>perduran.</em></h2><p>Celebraciones llenas de memoria, devoción y encuentro.</p></div>
          <a class="home-text-link" href={`${base}tradiciones/`}>Todas las tradiciones <HomeIcon name="arrow" /></a>
        </div>
        <div class="home-tradition-grid">
          {traditions.map((item, index) => (
            <article class={`home-tradition home-tradition-${item.tone}`}>
              <div class="home-tradition-art" aria-hidden="true"><span class="home-tradition-index">0{index + 1}</span><span class="home-tradition-symbol">{item.symbol}</span><span class="home-tradition-type">TRADICIONES DEL PERÚ</span></div>
              <div class="home-tradition-body">
                <span class="home-tradition-season">{item.season}</span>
                <h3><a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a></h3>
                <p>{item.text}</p>
                <a class="home-text-link" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`Conocer ${item.title} (fuente externa, nueva pestaña)`}>Conocer la tradición <HomeIcon name="arrow" /></a>
              </div>
            </article>
          ))}
        </div>
        <a class="home-calendar-link" href={`${base}calendario/`}><span>Siempre hay algo que nos reúne.</span><strong>Descubre el calendario de celebraciones <HomeIcon name="arrow" /></strong></a>
      </div>
    </section>

    <section class="home-about" id="acerca" aria-labelledby="about-title">
      <div class="container home-about-inner">
        <div class="home-about-symbol" aria-hidden="true"><HomeIcon name="spark" /></div>
        <div><span class="home-kicker">UN ESPACIO ABIERTO, UNA HISTORIA COMPARTIDA</span><h2 id="about-title">Las tradiciones viven<br />cuando las <em>compartimos.</em></h2><p>Una receta, una celebración, una forma de ver la vida. Tu historia también es parte de este lugar.</p></div>
        <a class="home-button home-button-white" href="#consultas">Comparte tu historia <HomeIcon name="arrow" /></a>
      </div>
    </section>

    <CmsMaterials title="Nuevas historias para compartir" limit={3} />

    <InquiryForms />
  </main>
  <SiteFooter />
</SiteLayout>
