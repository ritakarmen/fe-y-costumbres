---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<SiteLayout title="Material — Fe y Raíces" description="Lectura publicada desde OrlandoLalito." bodyClass="content-page">
  <SiteHeader current="actualidad" />
  <main class="page-main">
    <div class="container">
      <p><a class="home-text-link" href={`${base}/actualidad/`}>← Volver a actualidad</a></p>
      <article id="cms-article" class="cms-article" aria-live="polite">
        <p class="cms-article-state">Cargando material…</p>
      </article>
    </div>
  </main>
  <SiteFooter />
</SiteLayout>
<script is:inline define:vars={{ base }}>
  const supabaseUrl = "https://dogtzxodoitvrtspbvfe.supabase.co";
  const publishableKey = "sb_publishable_u04ir3tohb4iwoLTN83qYQ_jV8_BKmS";
  const article = document.querySelector("#cms-article");
  const slug = new URLSearchParams(window.location.search).get("slug");
  const make = (tag, className, text) => {
    const element = document.createElement(tag);
    if (className) element.className = className;
    if (text) element.textContent = text;
    return element;
  };
  async function load() {
    if (!slug) throw new Error("No se indicó qué material mostrar.");
    const endpoint = new URL("/rest/v1/content_items", supabaseUrl);
    endpoint.search = new URLSearchParams({
      select: "title,summary,body,type,image_url,slug,updated_at,sites!inner(name,slug)",
      "sites.slug": "eq.fe-y-costumbres",
      slug: `eq.${slug}`,
      status: "eq.Publicado",
      limit: "1"
    }).toString();
    const response = await fetch(endpoint, { headers: { apikey: publishableKey, Authorization: `Bearer ${publishableKey}` } });
    if (!response.ok) throw new Error("No encontramos un material publicado con ese enlace.");
    const rows = await response.json();
    const item = rows[0];
    if (!item) throw new Error("Este material no está publicado o ya no existe.");
    article.replaceChildren();
    article.append(make("p", "eyebrow", `${item.type || "Material"} · Fe y Costumbres`));
    article.append(make("h1", "", item.title));
    if (item.updated_at) article.append(make("p", "cms-article-date", new Intl.DateTimeFormat("es-PE", { dateStyle: "long" }).format(new Date(item.updated_at))));
    if (item.image_url) {
      const image = make("img", "cms-article-cover");
      image.src = item.image_url;
      image.alt = item.title;
      image.loading = "lazy";
      article.append(image);
    }
    if (item.summary) article.append(make("p", "cms-article-summary", item.summary));
    const body = make("div", "cms-article-body");
    for (const paragraph of (item.body || "").split(/\n+/).filter(Boolean)) body.append(make("p", "", paragraph));
    article.append(body);
  }
  load().catch((error) => {
    article.replaceChildren(make("h1", "", "Material no disponible"));
    article.append(make("p", "cms-article-state", error.message || "No pudimos cargar este contenido."));
  });
</script>
<style is:global>
  .cms-article { max-width:780px; margin:30px auto 0; }
  .cms-article h1 { margin:18px 0; color:var(--ink); font:600 clamp(36px,6vw,58px)/1.05 var(--serif); letter-spacing:-.04em; }
  .cms-article-date { color:var(--muted); font-size:12px; }
  .cms-article-cover { display:block; width:100%; max-height:520px; margin:26px 0; border-radius:20px; object-fit:cover; }
  .cms-article-summary { color:#4f708d; font:500 19px/1.6 var(--serif); }
  .cms-article-body { color:var(--ink); font-size:16px; line-height:1.9; }
  .cms-article-state { color:var(--muted); line-height:1.7; }
</style>
